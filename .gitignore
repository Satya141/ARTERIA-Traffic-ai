# ---- dependencies & build ------------------------------------------------
node_modules
dist
server/.venv
__pycache__/
*.pyc

# ---- model weights -------------------------------------------------------
# laya-arteria is 804 MB per checkpoint. GitHub hard-rejects any file over
# 100 MB, and even with LFS this does not belong in the source history:
# server/finetune_traffic.py rebuilds it from the dataset in ~32 minutes.
models/

# ---- generated data ------------------------------------------------------
# 12,005 labelled decisions, regenerated by: node tools/make_dataset.mjs 3000
data/*.jsonl

# ---- video render --------------------------------------------------------
# capture/frames holds ~3,150 intermediate JPEGs (1.7 GB) and the encoded
# MP4s are 70-165 MB each. Attach the finished video to a GitHub Release or
# link it, rather than carrying it in the git history forever.
capture/
*.mp4
*.webm

# ---- logs & local noise --------------------------------------------------
*.log
*.err
.DS_Store
Thumbs.db
.claude/
